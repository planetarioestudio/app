{
  "name": "planetario-estudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts *.ts *.js",
    "backup:restore": "node scripts/restore-backup.mjs",
    "firebase:rules:test": "firebase emulators:exec --project demo-planetario --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
